        "brief_id": { "type": "string" },
        "region_id": { "type": "string" },
        "region_name": { "type": "string" },
        "search_languages": { "type": "array", "items": { "type": "string" } },
        "daily_quota": { "type": "integer" },
        "sector_focus": { "type": "array", "items": { "type": "string" } },
        "query_templates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "language": { "type": "string" },
              "query": { "type": "string" },
              "target": { "type": "string" }
            }
          }
        },
        "local_directories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
