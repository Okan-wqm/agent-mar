        "dispatched_by": { "type": "string" }
      }
    },

    "BootstrapProgress": {
      "type": "object",
      "description": "Tracks agent generation progress. Managed by Bootstrap Orchestrator.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "completed", "failed"]
        },
        "current_wave": { "type": "integer", "minimum": 1, "maximum": 4 },
        "waves": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "wave_number": { "type": "integer" },
              "agents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "agent_name": { "type": "string" },
                    "status": {
                      "type": "string",
                      "enum": ["pending", "writing", "reviewing", "revising", "approved", "escalated"]
                    },
                    "current_round": { "type": "integer" },
                    "max_rounds": { "type": "integer", "default": 3 },
