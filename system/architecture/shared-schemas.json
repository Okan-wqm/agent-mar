    "SendLog": {
      "type": "object",
      "description": "Email dispatch records. Managed by Scheduler.",
      "required": ["log_date", "entries"],
      "properties": {
        "log_date": { "type": "string", "format": "date" },
        "entries": {
          "type": "array",
