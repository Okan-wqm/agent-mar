              "lead_id": { "type": "string" },
              "sequence_id": { "type": "string" },
              "step": { "type": "integer" },
              "email_file": { "type": "string", "description": "Path to the personalized email file" },
              "scheduled_time": { "type": "string", "format": "date-time" },
              "actual_send_time": { "type": "string", "format": "date-time" },
              "status": {
                "type": "string",
                "enum": ["scheduled", "sent", "delivered", "failed", "cancelled", "deferred"]
              },
              "failure_reason": { "type": "string" },
              "engagement_events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "event_type": {
                      "type": "string",
                      "enum": ["open", "click", "reply", "bounce", "unsubscribe", "complaint", "forward"]
                    },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "metadata": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "daily_summary": {
          "type": "object",
          "properties": {
            "total_scheduled": { "type": "integer" },
            "total_sent": { "type": "integer" },
            "total_failed": { "type": "integer" },
            "total_cancelled": { "type": "integer" },
            "send_limit_remaining": { "type": "integer" },
            "unique_recipients": { "type": "integer" }
          }
        },
        "generated_at": { "type": "string", "format": "date-time" },
        "generated_by": { "type": "string" }
      }
    },

    "RegionalStrategy": {
      "type": "object",
      "description": "Multi-region prospecting strategy. Produced by Regional Coordinator.",
      "required": ["strategy_date", "regions"],
      "properties": {
        "strategy_date": { "type": "string", "format": "date" },
        "total_daily_quota": { "type": "integer" },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["region_id", "daily_quota", "search_languages"],
            "properties": {
              "region_id": { "type": "string" },
              "region_name": { "type": "string" },
              "countries": { "type": "array", "items": { "type": "string" } },
              "daily_quota": { "type": "integer" },
              "allocation_percentage": { "type": "number" },
              "search_languages": { "type": "array", "items": { "type": "string" } },
              "sector_focus": { "type": "array", "items": { "type": "string" } },
              "priority": { "type": "string", "enum": ["high", "medium", "low"] },
              "market_size_score": { "type": "number", "minimum": 1, "maximum": 10 },
              "conversion_rate_historical": { "type": "number" },
              "strategic_priority_score": { "type": "number", "minimum": 1, "maximum": 10 },
              "research_difficulty": { "type": "string", "enum": ["easy", "moderate", "hard"] }
            }
          }
        },
        "rebalance_schedule": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "generated_by": { "type": "string" }
      }
    },

    "ScoutBrief": {
      "type": "object",
      "description": "Dispatch instructions for Regional Scout. Produced by Regional Coordinator.",
      "required": ["brief_id", "region_id", "search_languages", "daily_quota"],
